# HAProxy configuration for Pherb — pherb.example.com
#
# Install on the production host (not in a jail) since all backend
# jails use ip4=inherit and listen on 127.0.0.1.
#
# TLS certificate: /usr/local/etc/haproxy/certs/pherb.example.com.pem
# (combined cert+key+chain in PEM format)
#
# Install: pkg install haproxy
# Enable:  sysrc haproxy_enable=YES
# Config:  cp haproxy.cfg /usr/local/etc/haproxy.conf
# Start:   service haproxy start

global
    log /var/run/log    local0
    maxconn             2048
    daemon

defaults
    log                 global
    mode                http
    option              httplog
    option              dontlognull
    option              forwardfor
    timeout connect     5s
    timeout client      60s
    timeout server      300s
    retries             3

# --- Frontends ---

frontend http
    bind *:80
    http-request redirect scheme https code 301

frontend https
    bind *:443 ssl crt /usr/local/etc/haproxy/certs/pherb.example.com.pem alpn h2,http/1.1
    http-request set-header X-Forwarded-Proto https

    # Routing rules
    acl path_api    path_beg /api/
    acl path_audio  path_beg /audio/

    use_backend be_pherb_api    if path_api
    use_backend be_webdav       if path_audio
    default_backend be_pherb_api

# --- Backends ---

# Pherb REST API (PHP + Apache in pherb jail)
backend be_pherb_api
    option httpchk GET /api/v1/health
    http-check expect status 200
    server pherb 127.0.0.1:8082 check inter 30s fall 3 rise 2

# WebDAV file upload/download (Apache + mod_dav in webdav jail)
backend be_webdav
    timeout server 600s
    server webdav 127.0.0.1:8081 check inter 30s fall 3 rise 2
