# pherb-worker configuration
#
# All settings are optional. Missing keys fall back to compiled defaults.
# Specify config file path with: pherb-worker -c /path/to/worker.conf
# Default path: /usr/local/etc/pherb/worker.conf

# NATS server URL
# nats_url = nats://127.0.0.1:4222

# NATS subject wildcard (should not need changing)
# subject = pherb.worker.>

# Path to whisper-cli binary
# whisper_bin = /usr/local/bin/whisper-cli

# Directory containing GGML model files (ggml-*.bin)
# models_dir = /models/whisper

# Directory for stage output files (must be on same filesystem as audio)
# output_dir = /data/audio/outputs

# Pyannote diarization service URL
# pyannote_url = http://127.0.0.1:9090

# Wav2vec2 forced alignment service URL
# wav2vec2_url = http://127.0.0.1:9091

# Number of threads for whisper-cli
# threads = 8
