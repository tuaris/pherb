[mariadb]
host = 127.0.0.1
port = 3306
database = pherb
username = pherb
password = 

[nats]
host = 127.0.0.1
port = 4222

[worker]
; pherb-worker is a generic NATS-to-process bridge. It subscribes to subjects
; defined in its own config (worker.conf) and runs configured commands.
; The consumer dispatches to pherb.worker.{convert,whisper,pyannote,align}
; with audio_path + output_path in the payload. Workers can be deployed in
; any jail or host — they just need NATS access and shared storage.

[storage]
audio_path = /data/audio
output_path = /data/audio/outputs

[cleanup]
; Delete completed/failed jobs older than this many days
ttl_days = 7
