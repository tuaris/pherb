[mariadb]
host = 127.0.0.1
port = 3306
database = pherb
username = pherb
password = 

[nats]
host = 127.0.0.1
port = 4222

[worker]
; pherb-worker handles all ML stages (whisper, pyannote, wav2vec2) via NATS.
; All stages write output to the shared output_path directory.
; Consumer dispatches to pherb.worker.{whisper,pyannote,align} and listens
; on pherb.pipeline.completed for stage results.
;
; The worker config (pyannote_url, wav2vec2_url) lives in the worker binary
; itself — the consumer does not need these URLs.

[storage]
audio_path = /data/audio
output_path = /data/audio/outputs

[cleanup]
; Delete completed/failed jobs older than this many days
ttl_days = 7
; How often to run cleanup (in minutes)
interval_minutes = 60
