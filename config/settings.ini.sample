[mariadb]
host = 127.0.0.1
port = 3306
database = pherb
username = pherb
password = 

[nats]
host = 127.0.0.1
port = 4222

[whisper]
; Whisper transcription is dispatched to the whisper-worker via NATS.
; The worker writes raw output to output_dir, the consumer reads it back.
; output_dir must be accessible by both the worker (host) and consumer (jail).
;output_dir = /data/audio/outputs

[pyannote]
url = http://127.0.0.1:9090

[wav2vec2]
url = http://127.0.0.1:9091

[storage]
audio_path = /data/audio
output_path = /data/audio/outputs

[cleanup]
; Delete completed/failed jobs older than this many days
ttl_days = 7
; How often to run cleanup (in minutes)
interval_minutes = 60
