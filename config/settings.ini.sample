[mariadb]
host = 127.0.0.1
port = 3306
database = pherb
username = pherb
password = 

[nats]
host = 127.0.0.1
port = 4222

[whisper]
; Backend: "nats" (default), "cli", or "http"
; nats — NATS request/reply to whisper-worker on the host (recommended)
; cli  — shells out to whisper-cli directly (requires binary in jail)
; http — synchronous POST to whisper-server (subject to HTTP timeout)
backend = nats
; Only used when backend = cli
;cli_path = /usr/local/bin/whisper-cli
;models_dir = /models/whisper
;threads = 8
; Only used when backend = http
;url = http://127.0.0.1:8080

[pyannote]
url = http://127.0.0.1:9090

[wav2vec2]
url = http://127.0.0.1:9091

[storage]
audio_path = /data/audio
output_path = /data/audio/outputs

[cleanup]
; Delete completed/failed jobs older than this many days
ttl_days = 7
; How often to run cleanup (in minutes)
interval_minutes = 60
